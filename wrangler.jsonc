// Cloudflare Workers static assets config (no server code needed).
// Deploy: npx wrangler deploy   ·   Local preview: npx wrangler dev
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shipshop",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
